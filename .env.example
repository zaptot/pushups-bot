# Скопируй в файл .env и заполни
DISCORD_TOKEN=вставь_токен_бота
# ID твоего сервера (ПКМ по серверу → «Копировать ID сервера»). Без него команды появятся с задержкой до часа.
GUILD_ID=
# Supabase → Connect → Session pooler. Подставь свой пароль вместо [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Dota 2 (всё необязательно) ---
# Канал, куда бот пишет результаты автопроверки (ПКМ по каналу → «Копировать ID канала»)
DOTA_CHANNEL_ID=
# Как часто проверять новые матчи, в минутах
DOTA_CHECK_MINUTES=30
# Ключ OpenDota, если не хватит бесплатного лимита
OPENDOTA_API_KEY=

# --- PUBG ---
# Ключ с developer.pubg.com (без него PUBG-команды отключены)
PUBG_API_KEY=
# Платформа: steam, kakao, psn, xbox...
PUBG_SHARD=steam

# --- Казино (Discord Activity, необязательно) ---
# Порт игрового сервера. Пусто — казино выключено
ACTIVITY_PORT=
# Режим разработки: играть в браузере от имени этого участника (твой Discord ID). На боевом сервере оставь пустым
ACTIVITY_DEV_USER_ID=
# Приложение казино в Developer Portal: Application ID (пусто — приложение самого бота) и OAuth2 → Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Папка собранного фронтенда
ACTIVITY_DIR=activity/dist
